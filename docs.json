{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "DAO Café",
  "description": "The official high-performance GraphQL indexer for the CreateDAO protocol. Track proposals, analyze voting power, and monitor governance activity across Ethereum and Base.",
  "colors": {
    "primary": "#8b5cf6",
    "light": "#f0f0f5",
    "dark": "#0a0a0f"
  },
  "favicon": "/favicon.png",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://dao.cafe"
  },
  "fonts": {
    "heading": {
      "family": "Inter",
      "weight": 700
    },
    "body": {
      "family": "Inter",
      "weight": 400
    }
  },
  "appearance": {
    "default": "dark"
  },
  "background": {
    "decoration": "gradient"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "index"
            ]
          },
          {
            "group": "Indexer API",
            "pages": [
              "indexer/overview",
              "indexer/query-daos",
              "indexer/query-proposals",
              "indexer/decoded-actions",
              "indexer/query-votes",
              "indexer/query-delegation",
              "indexer/query-token-holders"
            ]
          },
          {
            "group": "SDK",
            "pages": [
              "sdk/overview",
              "sdk/react-hooks",
              "sdk/query-functions",
              "sdk/types",
              "sdk/advanced",
              "sdk/examples"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "GraphQL Playground",
          "href": "https://dao.cafe/graphql",
          "icon": "circle-play"
        },
        {
          "anchor": "GitHub",
          "href": "https://github.com/daocafe",
          "icon": "github"
        }
      ]
    }
  },
  "navbar": {
    "links": [
      {
        "label": "API",
        "href": "https://dao.cafe/graphql"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open Playground",
      "href": "https://dao.cafe/graphql"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/daocafe",
      "x": "http://x.com/createdao"
    },
    "links": [
      {
        "header": "Resources",
        "items": [
          {
            "label": "GraphQL API",
            "href": "https://dao.cafe/graphql"
          },
          {
            "label": "CreateDAO Protocol",
            "href": "https://createdao.org"
          }
        ]
      }
    ]
  },
  "seo": {
    "indexing": "all"
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude"
    ]
  }
}